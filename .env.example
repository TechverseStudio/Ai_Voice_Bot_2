# =====================================================================
# Margadarshak / Krishna's AI Property - Production Configuration Template
# =====================================================================

# 1. Operation & Safety Mode
# SIMULATION_MODE: Set to 'true' for safe development and local testing.
# Set to 'false' ONLY when ready for real live PSTN telephone calls.
SIMULATION_MODE=true

# LIVE_CALLS_ENABLED: Master switch. Must be 'true' and SIMULATION_MODE='false'
# to permit external carrier network dialing.
LIVE_CALLS_ENABLED=false

# 2. Database Configuration
# Default local SQLite:
DATABASE_URL=sqlite:///data/voice_agent.db
# Production PostgreSQL (with psycopg driver):
# DATABASE_URL=postgresql+psycopg://username:password@postgres-host:5432/voice_agent_db

# Connection Pool Settings (PostgreSQL)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30

# 3. Telephony Provider Selection (exotel | twilio | mock)
TELEPHONY_PROVIDER=mock
TELEPHONY_MOCK_MODE=true

# 4. Exotel Telephony Credentials (Required for Live Outbound & Inbound)
# Account SID (e.g., your Exotel Account Name / SID)
EXOTEL_ACCOUNT_SID=your_exotel_account_sid
# API Key and Token from Exotel Dashboard -> API Settings
EXOTEL_API_KEY=your_exotel_api_key
EXOTEL_API_TOKEN=your_exotel_api_token
# Active Virtual Landline / Mobile Caller ID (ExoPhone)
EXOTEL_CALLER_ID=09513886363
# Exotel Voice Applet ID configured with AgentStream applet
EXOTEL_APPLET_ID=1373255
EXOTEL_BASE_URL=https://api.exotel.com

# 5. Twilio Alternative Telephony Credentials (Optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# 6. AI Voice Services (Sarvam AI for Indic STT, LLM & Bulbul TTS)
# API Subscription Key from dashboard.sarvam.ai
SARVAM_API_KEY=your_sarvam_api_key
SARVAM_FALLBACK_API_KEY=

# 7. Public Ingress & Webhook Endpoints
# Public HTTPS URL of the deployed server (or ngrok tunnel for staging rehearsal)
PUBLIC_BASE_URL=https://your-domain-or-tunnel.ngrok-free.dev
AGENTSTREAM_PUBLIC_URL=https://your-domain-or-tunnel.ngrok-free.dev

# Callbacks & Media (Derived automatically if left blank)
# CALLBACK_BASE_URL=https://your-domain-or-tunnel.ngrok-free.dev/api/telephony/webhook
# MEDIA_BASE_URL=https://your-domain-or-tunnel.ngrok-free.dev/media
